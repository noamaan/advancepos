# ─────────────────────────────────────────────────────────────────────────────
# AdvancePOS environment configuration
# Copy this file to ".env" and fill in the values from your Firebase project.
# Firebase console → Project settings → "Your apps" → Web app → SDK setup.
# NEVER commit your real .env (it is git-ignored). For GitHub Pages deployment,
# add the SAME names as repository Secrets (Settings → Secrets → Actions).
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of emails allowed to claim the hidden Developer role.
# The claim only succeeds if the signed-in Auth user's email matches one of
# these AND the developer profile document exists in Firestore (see README §3
# "First developer bootstrap"). Keep this list to ONE trusted mailbox.
VITE_DEVELOPER_EMAILS=you@example.com
